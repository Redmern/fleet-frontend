@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>document.documentElement.classList.add("js");</script>
    <base href="./" />
    <title>fleet — gated orchestration for Claude Code agents, in your terminal</title>
    <meta name="description" content="fleet is a terminal-native orchestrator for Claude Code: agents and sub-orchestrators work under per-project MCP permissions and git gates, and an optional staged process (Ai-DLC) stops at every gate for your approval. Native binaries for Windows and Linux; macOS builds from source." />
    <link rel="canonical" href="@SiteUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="fleet — gated orchestration for Claude Code agents, in your terminal" />
    <meta property="og:description" content="Run many Claude Code agents across projects from one terminal. Every MCP tool and every git commit, push and merge runs under a policy you set; the Ai-DLC process stops at each gate for your approval." />
    <meta property="og:image" content="@(SiteUrl)og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The fleet dashboard in a terminal: a project's agents, their branches and live status." />
    <meta property="og:url" content="@SiteUrl" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="fleet — gated orchestration for Claude Code agents, in your terminal" />
    <meta name="twitter:description" content="Claude Code agents under permissions and git gates you set, with a staged process that stops for your approval. Windows and Linux binaries; macOS from source." />
    <meta name="twitter:image" content="@(SiteUrl)og-image.png" />

    <link rel="icon" href="favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="manifest" href="site.webmanifest" />
    <meta name="theme-color" content="#1A1B26" />
    <link rel="stylesheet" href="vendor/asciinema-player/asciinema-player.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="vendor/asciinema-player/asciinema-player.min.js" defer></script>
    <script src="js/demo-player.js" defer></script>
    <script src="js/ship-it.js" defer></script>
    <script src="js/site.js" defer></script>
    <script src="js/keys.js" defer></script>
    <script src="js/hero-orbs.js" defer></script>
    <script src="js/hero-headline.js" defer></script>
</body>

</html>

@code {
    // Absolute URL the site is published at (canonical, og:image). Override at export
    // time with the SiteUrl environment variable, e.g. SiteUrl=https://fleet-tui.dev/.
    private string SiteUrl => Configuration["SiteUrl"] is { Length: > 0 } url ? url : "https://fleet-tui.dev/";
}
