<section class="hero">
    <div class="container corner-frame" style="color: var(--border-bright); padding-top: 24px; padding-bottom: 8px;">
        <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
        <div style="color: var(--fg);">
        <div class="eyebrow">Active development · Windows, Linux, macOS</div>
        <h1>Run a fleet of AI coding agents without leaving your terminal.</h1>
        <p class="lede">
            Pick a project, get a dashboard, dispatch background agents to work tasks while you keep coding.
            Fleet is a terminal-native orchestrator for Claude Code and friends, running the same way on Windows,
            Linux, and macOS — built on WezTerm, the one terminal that's genuinely cross-platform.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary" href="#install">Install fleet</a>
            <a class="btn btn-ghost" href="https://github.com/Redmern/fleet-tui">View source</a>
        </div>

        <div class="install-block">
            <div class="platform-toggle" data-platform-toggle role="group" aria-label="Choose your platform">
                <button type="button" class="active" data-platform="windows">Windows</button>
                <button type="button" data-platform="linux">Linux</button>
            </div>
            <div class="code-block">
                <pre data-install-command data-windows="irm https://raw.githubusercontent.com/Redmern/fleet-tui/main/scripts/get-fleet.ps1 | iex" data-linux="curl -fsSL https://raw.githubusercontent.com/Redmern/fleet-tui/main/scripts/get-fleet.sh | sh">irm https://raw.githubusercontent.com/Redmern/fleet-tui/main/scripts/get-fleet.ps1 | iex</pre>
                <button type="button" class="copy-btn" data-copy-target="[data-install-command]">copy</button>
            </div>
            <p class="install-note">Single native binary. No runtime to install. See <a href="#install">full install instructions</a> below.</p>
        </div>
        </div>
    </div>

    <div class="container" style="margin-top: 56px;">
        <div class="terminal-window" data-terminal-mockup aria-hidden="true">
            <div class="terminal-titlebar">
                <div class="terminal-dots"><span></span><span></span><span></span></div>
                <div class="title">wezterm — fleet</div>
            </div>
            <div class="terminal-body" data-terminal-body>
                <!-- Populated and animated by js/terminal-mockup.js. Static fallback below renders with JS disabled. -->
                <noscript>
                    <div class="terminal-line"><span class="prompt">$</span><span class="fill">fleet</span></div>
                    <div class="terminal-line"><span class="fill">? Pick a project › fleet-frontend</span></div>
                    <div class="terminal-line"><span class="fill">Opening dashboard for fleet-frontend…</span></div>
                    <div class="terminal-line"><span class="prompt">$</span><span class="fill">fleet dispatch "add dark mode toggle"</span></div>
                    <div class="terminal-line"><span class="status-dot done"></span><span class="fill">sub-orchestrator #2 — done</span></div>
                </noscript>
            </div>
        </div>
    </div>
</section>
