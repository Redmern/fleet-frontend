<section id="requirements">
    <div class="container">
        <div class="section-heading reveal">
            <span class="kicker">Requirements</span>
            <h2>What you need before you install.</h2>
        </div>

        <div class="rule-columns">
            <div class="rule-col reveal">
                <span class="rule-kicker">Terminal-native</span>
                <p>No browser tab, no Electron shell. fleet brings its own panes, tabs and splits.</p>
            </div>
            <div class="rule-col reveal">
                <span class="rule-kicker">Single binary</span>
                <p>NativeAOT-compiled C#/.NET. Nothing else to install.</p>
            </div>
            <div class="rule-col reveal">
                <span class="rule-kicker">Bring your agent</span>
                <p>Claude Code today — the pane is yours to configure.</p>
            </div>
        </div>

        <div class="requirements-grid">
            <ul class="req-list">
                <li><span class="req-name">Git</span> For repo management and the finish workflow. <span class="req-tag required">required</span></li>
                <li><span class="req-name">An AI harness</span> Claude Code today. <span class="req-tag required">required</span></li>
                <li><span class="req-name">Nerd Font</span> For the pill glyphs in the top bar and the dashboard's status glyphs. <span class="req-tag optional">recommended</span></li>
                <li><span class="req-name">Neovim</span> neo-tree + claudecode.nvim, for the editor flow. <span class="req-tag optional">integration</span></li>
                <li><span class="req-name">yazi</span> Folder picker when adding a repository. <span class="req-tag optional">integration</span></li>
            </ul>

            <div class="platform-support">
                <table>
                    <thead>
                        <tr><th>Platform</th><th>Distribution</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><span class="os-label"><OsIcon Os="windows" />Windows</span></td><td>Native binary (x64), built-in multiplexer included</td></tr>
                        <tr><td><span class="os-label"><OsIcon Os="linux" />Linux</span></td><td>Native binary (x64), built-in multiplexer included</td></tr>
                        <tr><td><span class="os-label"><OsIcon Os="macos" />macOS</span></td><td>Build from source only — no published binary</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
