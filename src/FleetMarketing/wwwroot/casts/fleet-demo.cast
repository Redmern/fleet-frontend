[66.16, "o", "\u001b[?25l\u001b[3;1H* \u001b[33m95f2333 (\u001b[1m\u001b[32madd-health-endpoint\u001b[0m\u001b[33m)\u001b[39m Add GET /health endpoint    \u001b[34m│\u001b[39mconst http = require(\"http\");\u001b[0m\u001b[K\u001b[5;1H$                                                           \u001b[34m│\u001b[39mconst routes = {\u001b[0m\u001b[K\u001b[6;1H                                                            \u001b[34m│\u001b[39m  \"/products\": () => [{ id: 1, name: \"Mug\" }, { id: 2, name\u001b[0m\u001b[K\u001b[7;1H                                                            \u001b[34m│\u001b[39m: \"Tee\" }],\u001b[0m\u001b[K\u001b[8;1H                                                            \u001b[34m│\u001b[39m};\u001b[0m\u001b[K\u001b[10;1H                                                            \u001b[34m│\u001b[39mhttp.createServer((req, res) => {\u001b[0m\u001b[K\u001b[11;1H                                                            \u001b[34m│\u001b[39m  const route = routes[req.url];\u001b[0m\u001b[K\u001b[12;1H                                                            \u001b[34m│\u001b[39m  if (!route) { res.writeHead(404); return res.end(); }\u001b[0m\u001b[K\u001b[13;1H                                                            \u001b[34m│\u001b[39m  res.writeHead(200, { \"Content-Type\": \"application/json\" }\u001b[0m\u001b[K\u001b[14;1H                                                            \u001b[34m│\u001b[39m);\u001b[0m\u001b[K\u001b[15;1H                                                            \u001b[34m│\u001b[39m  res.end(JSON.stringify(route()));\u001b[0m\u001b[K\u001b[16;1H                                                            \u001b[34m│\u001b[39m}).listen(3000);\u001b[0m\u001b[K\u001b[17;1H                                                            \u001b[34m│\u001b[39m$\u001b[0m\u001b[K\u001b[17;64H\u001b[?25h"]
