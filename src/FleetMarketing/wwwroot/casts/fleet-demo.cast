1b[22;1H\u001b[38;2;26;27;38m\u001b[48;2;22;22;30m \u001b[39m                         \u001b[1m\u001b[38;2;21;22;30m\u001b[48;2;26;27;38m│\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m  - \u001b[1mTests:\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m the repo has no test suite, so I didn't add a test. I started the server and\u001b[0m\u001b[K\u001b[23;1H\u001b[38;2;26;27;38m\u001b[48;2;22;22;30m \u001b[39m                         \u001b[1m\u001b[38;2;21;22;30m\u001b[48;2;26;27;38m│\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m    checked with curl: \u001b[38;2;177;185;249m/health\u001b[38;2;192;202;245m returned 200 \u001b[38;2;177;185;249m\"ok\"\u001b[38;2;192;202;245m and \u001b[38;2;177;185;249m/products\u001b[38;2;192;202;245m still worked.\u001b[0m\u001b[K\u001b[24;1H\u001b[38;2;26;27;38m\u001b[48;2;22;22;30m \u001b[39m                         \u001b[1m\u001b[38;2;21;22;30m\u001b[48;2;26;27;38m│\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m  - \u001b[1mPort 3000:\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m after I stopped my test server, a request to \u001b[38;2;177;185;249mlocalhost:3000\u001b[38;2;192;202;245m timed out instead\u001b[0m\u001b[K\u001b[25;1H\u001b[38;2;26;27;38m\u001b[48;2;22;22;30m \u001b[39m                         \u001b[1m\u001b[38;2;21;22;30m\u001b[48;2;26;27;38m│\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m    of being refused. Something else may be holding that port, so check it if the next \u001b[38;2;177;185;249mnode \u001b[38;2;192;202;245m\u001b[0m\u001b[K\u001b[26;1H\u001b[38;2;26;27;38m\u001b[48;2;22;22;30m \u001b[39m                         \u001b[1m\u001b[38;2;21;22;30m\u001b[48;2;26;27;38m│\u001b[0m\u001b[38;2;192;202;245m\u001b[48;2;26;27;38m    \u001b[38;2;177;185;249mserver.js\u001b[38;2;192;202;245m fails to start.\u001b[0m\u001b[K\u001b[27;1H\u001b[38;2;26;27;38m\u001b[48;2;22;22;30m \u001b[39m                         \u001b[1m\u001b[38;2;21;22;30m\u001b[48;2;26;27;38m│\u001