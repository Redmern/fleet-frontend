[72.448, "o", "\u001b[?25l\u001b[1;1H \u001b[38;2;180;190;254m\u001b[1m\u001b[38;2;17;17;27m\u001b[48;2;180;190;254m shop ● 1 \u001b[0m\u001b[38;2;180;190;254m\u001b[39m \u001b[38;2;108;112;134m 1:dash \u001b[39m \u001b[38;2;108;112;134m 2:add-health-endpoint \u001b[39m \u001b[38;2;108;112;134m 3:api/add-health-endpoint \u001b[39m \u001b[38;2;180;190;254m\u001b[1m\u001b[38;2;17;17;27m\u001b[48;2;180;190;254m 4:shell \u001b[0m\u001b[38;2;180;190;254m\u001b[39m\u001b[0m\u001b[K\u001b[2;1H$ git -C api log --oneline --graph --all                    \u001b[34m│\u001b[39m$ cat api/main/server.js\u001b[0m\u001b[K\u001b[3;1H* \u001b[33m95f2333 (\u001b[1m\u001b[32madd-health-endpoint\u001b[0m\u001b[33m)\u001b[39m Add GET /health endpoint    \u001b[34m│\u001b[39mconst http = require(\"http\");\u001b[0m\u001b[K\u001b[4;1H* \u001b[33mfb881cd (\u001b[1m\u001b[36mHEAD\u001b[0m\u001b[33m -> \u001b[1m\u001b[32mmain\u001b[0m\u001b[33m)\u001b[39m Initial commit                     \u001b[34m│\u001b[39m\u001b[0m\u001b[K\u001b[5;1H$                                                           \u001b[34m│\u001b[39mconst routes = {\u001b[0m\u001b[K\u001b[6;1H                                                            \u001b[34m│\u001b[39m  \"/products\": () => [{ id: 1, name: \"Mug\" }, { id: 2, name\u001b[0m\u001b[K\u001b[7;1H                                                            \u001b[34m│\u001b[39m: \"Tee\" }],\u001b[0m\u001b[K\u001b[8;1H                                                            \u001b[34m│\u001b[39m};\u001b[0m\u001b[K\u001b[9;1H                                                            \u001b[34m│\u001b[39m\u001b[0m\u001b[K\u001b[10;1H                                                            \u001b[34m│\u001b[39mhttp.createServer((req, res) => {\u001b[0m\u001b[K\u001b[11;1H                                                            \u001b[34m│\u001b[39m  const route = routes[req.url];\u001b[0m\u001b[K\u001b[12;1H                                            